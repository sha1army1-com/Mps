<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SHA Global Enterprise System & School OS</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 font-sans antialiased min-h-screen flex flex-col justify-between">

    <!-- Header / Navbar -->
    <header class="bg-slate-800 border-b border-slate-700 p-4 shadow-md flex justify-between items-center">
        <div class="flex items-center space-x-3">
            <span class="text-2xl font-bold bg-gradient-to-r from-blue-400 to-indigo-500 bg-clip-text text-transparent">SHA Global OS</span>
            <span class="text-xs bg-indigo-600 px-2 py-1 rounded text-white font-semibold">Enterprise AI Edition</span>
        </div>
        <div id="user-status" class="text-sm text-slate-300">Not Logged In</div>
    </header>

    <!-- Main Container -->
    <main class="flex-grow p-4 md:p-8 max-w-6xl mx-auto w-full">

        <!-- Login Section -->
        <div id="login-section" class="bg-slate-800 p-6 md:p-8 rounded-xl shadow-2xl max-w-md mx-auto border border-slate-700">
            <h2 class="text-2xl font-bold mb-6 text-center text-blue-400">Portal Login & Master Access</h2>
            <form id="login-form" onsubmit="handleLogin(event)" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium mb-1">School Name / Code</label>
                    <input type="text" id="school-code" required class="w-full bg-slate-900 border border-slate-700 rounded p-2.5 text-white focus:ring-2 focus:ring-blue-500 outline-none" placeholder="e.g. SHA-DELHI-01">
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Username / Master Key</label>
                    <input type="text" id="username" required class="w-full bg-slate-900 border border-slate-700 rounded p-2.5 text-white focus:ring-2 focus:ring-blue-500 outline-none" placeholder="Enter username or SHAURYASHA">
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Password</label>
                    <input type="password" id="password" required class="w-full bg-slate-900 border border-slate-700 rounded p-2.5 text-white focus:ring-2 focus:ring-blue-500 outline-none" placeholder="••••••••">
                </div>
                <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-semibold py-2.5 rounded transition duration-200 shadow-lg">Secure Login & Telegram OTP</button>
            </form>
        </div>

        <!-- Dashboard Section (Hidden by Default) -->
        <div id="dashboard-section" class="hidden space-y-6">
            <div class="flex justify-between items-center bg-slate-800 p-4 rounded-xl border border-slate-700">
                <div class="flex items-center space-x-4">
                    <img id="profile-pic-preview" src="https://via.placeholder.com/60" class="w-14 h-14 rounded-full object-cover border-2 border-blue-400">
                    <div>
                        <h3 id="welcome-title" class="text-xl font-bold text-blue-300">Welcome</h3>
                        <p id="role-display" class="text-sm text-slate-400">Role: Loading...</p>
                    </div>
                </div>
                <div class="flex items-center space-x-3">
                    <label class="bg-slate-700 hover:bg-slate-600 px-3 py-1.5 rounded text-sm cursor-pointer transition">
                        Change Photo <input type="file" class="hidden" onchange="updateProfilePic(event)">
                    </label>
                    <button onclick="logout()" class="bg-red-600 hover:bg-red-500 px-4 py-2 rounded text-sm font-semibold transition">Logout</button>
                </div>
            </div>

            <!-- Dynamic Dashboard Content based on Role -->
            <div id="role-content" class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Dynamically populated via JS -->
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-800 border-t border-slate-700 p-4 text-center text-xs text-slate-500">
        &copy; 2026 SHA Global Enterprise System. All Rights Reserved. Powered by Secure Cloud & AI.
    </footer>

    <!-- JavaScript Logic -->
    <script>
        let currentUser = null;

        function handleLogin(event) {
            event.preventDefault();
            const school = document.getElementById('school-code').value;
            const user = document.getElementById('username').value;
            
            // Super Admin Master Override check
            if (user === 'SHAURYASHA' || user === 'SHAURYASHA123') {
                currentUser = { name: 'Super Admin (SHAURYASHA)', role: 'superadmin', school: 'Global Master HQ' };
            } else if (user.toLowerCase().includes('principal')) {
                currentUser = { name: 'School Principal', role: 'principal', school: school };
            } else if (user.toLowerCase().includes('teacher')) {
                currentUser = { name: 'Staff Teacher', role: 'teacher', school: school };
            } else {
                currentUser = { name: 'Student Scholar', role: 'student', school: school, inExam: false };
            }

            document.getElementById('login-section').classList.add('hidden');
            document.getElementById('dashboard-section').classList.remove('hidden');
            document.getElementById('user-status').innerText = `Logged in as: ${currentUser.name}`;
            document.getElementById('welcome-title').innerText = currentUser.name;
            document.getElementById('role-display').innerText = `Role: ${currentUser.role.toUpperCase()} | School: ${currentUser.school}`;

            renderDashboard();
        }

        function renderDashboard() {
            const container = document.getElementById('role-content');
            container.innerHTML = '';

            if (currentUser.role === 'superadmin') {
                container.innerHTML = `
                    <div class="bg-slate-800 p-6 rounded-xl border border-slate-700 md:col-span-2">
                        <h3 class="text-lg font-bold mb-4 text-indigo-400">🌍 Global Leaderboard (Top 100 World Ranks)</h3>
                        <p class="text-xs text-slate-400 mb-4">Note: Ranks below Top 100 are hidden to maintain student motivation.</p>
                        <div class="space-y-3 max-h-80 overflow-y-auto">
                            <div class="flex items-center justify-between bg-slate-900 p-3 rounded border border-amber-500/50">
                                <div class="flex items-center space-x-3">
                                    <span class="bg-amber-500 text-slate-950 font-bold px-2 py-0.5 rounded text-xs">TOP 1 👑</span>
                                    <img src="https://via.placeholder.com/40" class="w-10 h-10 rounded-full object-cover">
                                    <div><p class="font-semibold">Aarav Sharma</p><p class="text-xs text-slate-400">SHA Delhi Public School</p></div>
                                </div>
                                <span class="text-green-400 font-bold">99.8% Score</span>
                            </div>
                            <div class="flex items-center justify-between bg-slate-900 p-3 rounded border border-slate-700">
                                <div class="flex items-center space-x-3">
                                    <span class="bg-slate-700 text-white font-bold px-2 py-0.5 rounded text-xs">TOP 2</span>
                                    <img src="https://via.placeholder.com/40" class="w-10 h-10 rounded-full object-cover">
                                    <div><p class="font-semibold">Priya Verma</p><p class="text-xs text-slate-400">SHA Mumbai International</p></div>
                                </div>
                                <span class="text-green-400 font-bold">98.5% Score</span>
                            </div>
                        </div>
                    </div>
                    <div class="bg-slate-800 p-6 rounded-xl border border-slate-700">
                        <h3 class="text-lg font-bold mb-4 text-indigo-400">🤖 SHA MasterMind AI</h3>
                        <textarea class="w-full bg-slate-900 border border-slate-700 rounded p-3 text-sm h-32 focus:outline-none mb-3" placeholder="Command AI to lock schools, check revenue, or broadcast notices..."></textarea>
                        <button onclick="alert('AI Master Command Executed Successfully!')" class="w-full bg-indigo-600 hover:bg-indigo-500 py-2 rounded font-semibold text-sm">Execute AI Command</button>
                    </div>
                `;
            } else if (currentUser.role === 'principal' || currentUser.role === 'teacher') {
                container.innerHTML = `
                    <div class="bg-slate-800 p-6 rounded-xl border border-slate-700 md:col-span-2">
                        <h3 class="text-lg font-bold mb-4 text-blue-400">🏫 School Management & AI Paper Generator</h3>
                        <p class="text-sm text-slate-300 mb-4">Manage students, adjust fees/fines, and use AI to generate automated test papers instantly.</p>
                        <button onclick="alert('AI generated new test paper successfully!')" class="bg-blue-600 hover:bg-blue-500 px-4 py-2 rounded text-sm font-semibold">Generate AI Test Paper</button>
                    </div>
                    <div class="bg-slate-800 p-6 rounded-xl border border-slate-700">
                        <h3 class="text-lg font-bold mb-4 text-blue-400">💡 Staff AI Assistant</h3>
                        <textarea class="w-full bg-slate-900 border border-slate-700 rounded p-3 text-sm h-32 focus:outline-none mb-3" placeholder="Ask AI for lesson planning or grading assistance..."></textarea>
                        <button onclick="alert('AI Assistant response generated.')" class="w-full bg-blue-600 hover:bg-blue-500 py-2 rounded font-semibold text-sm">Ask AI</button>
                    </div>
                `;
            } else {
                container.innerHTML = `
                    <div class="bg-slate-800 p-6 rounded-xl border border-slate-700 md:col-span-2">
                        <h3 class="text-lg font-bold mb-4 text-emerald-400">🎓 Student Examination & Scoreboard</h3>
                        <p class="text-sm text-slate-300 mb-2">Your Exam Status: <span class="text-amber-400 font-semibold">Ready</span></p>
                        <div class="bg-slate-900 p-4 rounded mb-4">
                            <p class="text-sm">Latest Test Score: <strong class="text-green-400">92 / 100 (Top 15 Rank)</strong></p>
                        </div>
                        <button onclick="toggleExamMode()" id="exam-btn" class="bg-emerald-600 hover:bg-emerald-500 px-4 py-2 rounded text-sm font-semibold">Start Exam (AI Will Disable)</button>
                    </div>
                    <div class="bg-slate-800 p-6 rounded-xl border border-slate-700" id="ai-tutor-box">
                        <h3 class="text-lg font-bold mb-4 text-emerald-400">🤖 AI Study Tutor</h3>
                        <textarea class="w-full bg-slate-900 border border-slate-700 rounded p-3 text-sm h-32 focus:outline-none mb-3" placeholder="Ask your homework doubts here..."></textarea>
                        <button onclick="alert('AI Tutor answered your doubt.')" class="w-full bg-emerald-600 hover:bg-emerald-500 py-2 rounded font-semibold text-sm">Ask Doubt</button>
                    </div>
                `;
            }
        }

        function toggleExamMode() {
            const btn = document.getElementById('exam-btn');
            const aiBox = document.getElementById('ai-tutor-box');
            if (btn.innerText.includes('Start')) {
                btn.innerText = 'End Exam (AI Enabled Again)';
                btn.classList.replace('bg-emerald-600', 'bg-red-600');
                aiBox.style.opacity = '0.3';
                aiBox.style.pointerEvents = 'none';
                alert('Exam Started! AI Study Assistant is temporarily disabled to prevent cheating.');
            } else {
                btn.innerText = 'Start Exam (AI Will Disable)';
                btn.classList.replace('bg-red-600', 'bg-emerald-600');
                aiBox.style.opacity = '1';
                aiBox.style.pointerEvents = 'auto';
                alert('Exam Ended. AI Study Assistant is now active again.');
            }
        }

        function updateProfilePic(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('profile-pic-preview').src = e.target.result;
                }
                reader.readAsDataURL(file);
            }
        }

        function logout() {
            location.reload();
        }
    </script>
</body>
</html>
